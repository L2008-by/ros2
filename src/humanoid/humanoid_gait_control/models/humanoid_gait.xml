<!--
  双足步态行走人形机器人 MJCF 模型（humanoid_gait）
  ==================================================
  - 自由度：双腿（髋 roll / 髋 pitch / 膝 pitch / 踝 pitch / 踝 roll）×2
            + 双臂（肩 pitch / 肘 pitch）×2 + 颈，共 16 个驱动关节
  - 驱动：全部 motor（关节力矩），步态由关节空间 PD 伺服跟踪规划轨迹实现
    （见 humanoid_gait_control/gait_planner.py 与 sim_core.py）
  - 与键盘遥控模块（humanoid_simple.xml）共用双腿拓扑，差异：
      1) 脚掌加长（0.12 m），扩大支撑多边形，利于单脚支撑相稳定；
      2) 膝/踝行程不变，髋 pitch 放开至 ±1.7 rad 支撑大步幅；
      3) 蓝灰配色，与仓库其它人形模块（橙/米色）区分。
  - 模型与代码均为课程作业自建实现，形状参数参考 MuJoCo 官方
    humanoid / ROBOTIS OP3 的设计思路。
-->
<mujoco model="humanoid_gait">
  <compiler angle="radian" coordinate="local"/>
  <option timestep="0.002" gravity="0 0 -9.81" iterations="50" integrator="Euler"/>

  <default>
    <joint armature="0.02" damping="1.5" frictionloss="0.5"/>
    <motor ctrlrange="-300 300" ctrllimited="true"/>
    <geom type="capsule" density="1000" friction="1.0 0.4 0.1" contype="1" conaffinity="1"/>
  </default>

  <worldbody>
    <light dir="0 0 -1" diffuse="0.85 0.85 0.85" ambient="0.45 0.45 0.45"/>
    <geom name="ground" type="plane" size="20 20 0.02" rgba="0.55 0.55 0.58 1" friction="1.2 0.6 0.2"/>

    <!-- 场景参照物（固定，供行走演示与相机观察） -->
    <camera name="overview" pos="1.2 4.0 2.0" xyaxes="-0.914 0.406 0 -0.118 -0.266 0.957" fovy="55"/>
    <camera name="side" pos="1.5 -4.5 1.2" xyaxes="0.4 0.916 0 0 -0.124 0.992" fovy="55"/>
    <body name="mile0" pos="0 1.6 0.6">
      <geom name="mile0g" type="cylinder" size="0.05 0.6" rgba="0.9 0.9 0.9 1"/>
    </body>
    <body name="mile1" pos="1.0 1.6 0.6">
      <geom name="mile1g" type="cylinder" size="0.05 0.6" rgba="0.9 0.9 0.9 1"/>
    </body>
    <body name="mile2" pos="2.0 1.6 0.6">
      <geom name="mile2g" type="cylinder" size="0.05 0.6" rgba="0.9 0.9 0.9 1"/>
    </body>

    <!-- ==================== 人形机器人 ==================== -->
    <body name="root" pos="0 0 0.95">
      <freejoint name="root"/>

      <!-- 骨盆 -->
      <geom name="pelvis" type="box" size="0.10 0.13 0.06" pos="0 0 0.0" rgba="0.42 0.60 0.85 1" mass="6"/>

      <!-- ===== 左腿 ===== -->
      <body name="hip_l" pos="-0.02 0.16 -0.05">
<inertial pos="0 0 0" mass="0.05" diaginertia="0.001 0.001 0.001"/>
        <joint name="hip_roll_l" axis="1 0 0" range="-0.5 0.5"/>
        <body name="hip2_l" pos="0 0 0.0">
<inertial pos="0 0 0" mass="0.05" diaginertia="0.001 0.001 0.001"/>
          <joint name="hip_pitch_l" axis="0 1 0" range="-1.7 1.7"/>
          <body name="thigh_l" pos="0 0 -0.18">
            <geom name="thigh_geom_l" fromto="0 0 0 0 0 -0.34" size="0.055" rgba="0.42 0.60 0.85 1" mass="3.2"/>
            <body name="knee_l" pos="0 0 -0.34">
<inertial pos="0 0 0" mass="0.05" diaginertia="0.001 0.001 0.001"/>
              <joint name="knee_l" axis="0 1 0" range="-2.5 1.5"/>
              <body name="shin_l" pos="0 0 -0.16">
                <geom name="shin_geom_l" fromto="0 0 0 0 0 -0.30" size="0.045" rgba="0.42 0.60 0.85 1" mass="2.2"/>
                <body name="ankle_l" pos="0 0 -0.30">
<inertial pos="0 0 0" mass="0.05" diaginertia="0.001 0.001 0.001"/>
                  <joint name="ankle_pitch_l" axis="0 1 0" range="-0.9 0.9"/>
                  <body name="foot_l" pos="0.03 0 -0.03">
                    <joint name="ankle_roll_l" axis="1 0 0" range="-0.6 0.6"/>
                    <geom name="foot_geom_l" type="box" size="0.12 0.07 0.025" rgba="0.25 0.32 0.42 1" mass="1.0"/>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>

      <!-- ===== 右腿（对称） ===== -->
      <body name="hip_r" pos="-0.02 -0.16 -0.05">
<inertial pos="0 0 0" mass="0.05" diaginertia="0.001 0.001 0.001"/>
        <joint name="hip_roll_r" axis="1 0 0" range="-0.5 0.5"/>
        <body name="hip2_r" pos="0 0 0.0">
<inertial pos="0 0 0" mass="0.05" diaginertia="0.001 0.001 0.001"/>
          <joint name="hip_pitch_r" axis="0 1 0" range="-1.7 1.7"/>
          <body name="thigh_r" pos="0 0 -0.18">
            <geom name="thigh_geom_r" fromto="0 0 0 0 0 -0.34" size="0.055" rgba="0.42 0.60 0.85 1" mass="3.2"/>
            <body name="knee_r" pos="0 0 -0.34">
<inertial pos="0 0 0" mass="0.05" diaginertia="0.001 0.001 0.001"/>
              <joint name="knee_r" axis="0 1 0" range="-2.5 1.5"/>
              <body name="shin_r" pos="0 0 -0.16">
                <geom name="shin_geom_r" fromto="0 0 0 0 0 -0.30" size="0.045" rgba="0.42 0.60 0.85 1" mass="2.2"/>
                <body name="ankle_r" pos="0 0 -0.30">
<inertial pos="0 0 0" mass="0.05" diaginertia="0.001 0.001 0.001"/>
                  <joint name="ankle_pitch_r" axis="0 1 0" range="-0.9 0.9"/>
                  <body name="foot_r" pos="0.03 0 -0.03">
                    <joint name="ankle_roll_r" axis="1 0 0" range="-0.6 0.6"/>
                    <geom name="foot_geom_r" type="box" size="0.12 0.07 0.025" rgba="0.25 0.32 0.42 1" mass="1.0"/>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>

      <!-- ===== 躯干 + 双臂 + 头 ===== -->
      <body name="torso" pos="0 0 0.08">
        <geom name="torso_geom" type="box" size="0.11 0.09 0.20" pos="0 0 0.20" rgba="0.42 0.60 0.85 1" mass="14"/>

        <!-- 左臂 -->
        <body name="arm_l" pos="-0.10 0.11 0.40">
<inertial pos="0 0 0" mass="0.05" diaginertia="0.001 0.001 0.001"/>
          <joint name="shoulder_pitch_l" axis="0 1 0" range="-1.5 1.5"/>
          <body name="upper_l" pos="0 0 -0.14">
<inertial pos="0 0 0" mass="0.05" diaginertia="0.001 0.001 0.001"/>
            <geom name="upper_geom_l" fromto="0 0 0 0 0 -0.28" size="0.035" rgba="0.42 0.60 0.85 1" mass="1.0"/>
            <body name="elbow_l" pos="0 0 -0.28">
<inertial pos="0 0 0" mass="0.05" diaginertia="0.001 0.001 0.001"/>
              <joint name="elbow_l" axis="0 1 0" range="-2.0 0"/>
              <body name="fore_l" pos="0 0 -0.14">
                <geom name="fore_geom_l" fromto="0 0 0 0 0 -0.28" size="0.03" rgba="0.42 0.60 0.85 1" mass="0.7"/>
              </body>
            </body>
          </body>
        </body>

        <!-- 右臂 -->
        <body name="arm_r" pos="-0.10 -0.11 0.40">
<inertial pos="0 0 0" mass="0.05" diaginertia="0.001 0.001 0.001"/>
          <joint name="shoulder_pitch_r" axis="0 1 0" range="-1.5 1.5"/>
          <body name="upper_r" pos="0 0 -0.14">
<inertial pos="0 0 0" mass="0.05" diaginertia="0.001 0.001 0.001"/>
            <geom name="upper_geom_r" fromto="0 0 0 0 0 -0.28" size="0.035" rgba="0.42 0.60 0.85 1" mass="1.0"/>
            <body name="elbow_r" pos="0 0 -0.28">
<inertial pos="0 0 0" mass="0.05" diaginertia="0.001 0.001 0.001"/>
              <joint name="elbow_r" axis="0 1 0" range="-2.0 0"/>
              <body name="fore_r" pos="0 0 -0.14">
                <geom name="fore_geom_r" fromto="0 0 0 0 0 -0.28" size="0.03" rgba="0.42 0.60 0.85 1" mass="0.7"/>
              </body>
            </body>
          </body>
        </body>

        <!-- 头 -->
        <body name="head" pos="0 0 0.40">
<inertial pos="0 0 0" mass="0.05" diaginertia="0.001 0.001 0.001"/>
          <joint name="neck" axis="0 1 0" range="-0.6 0.6"/>
          <body name="head_box" pos="0 0 0.05">
            <geom name="head_geom" type="sphere" size="0.09" rgba="0.30 0.34 0.40 1" mass="1.2"/>
            <camera name="front_camera" pos="0 0 0.10" xyaxes="1 0 0 0 1 0" fovy="60"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="hip_roll_l" joint="hip_roll_l"/>
    <motor name="hip_pitch_l" joint="hip_pitch_l"/>
    <motor name="knee_l" joint="knee_l"/>
    <motor name="ankle_pitch_l" joint="ankle_pitch_l"/>
    <motor name="ankle_roll_l" joint="ankle_roll_l"/>
    <motor name="hip_roll_r" joint="hip_roll_r"/>
    <motor name="hip_pitch_r" joint="hip_pitch_r"/>
    <motor name="knee_r" joint="knee_r"/>
    <motor name="ankle_pitch_r" joint="ankle_pitch_r"/>
    <motor name="ankle_roll_r" joint="ankle_roll_r"/>
    <motor name="shoulder_pitch_l" joint="shoulder_pitch_l"/>
    <motor name="elbow_l" joint="elbow_l"/>
    <motor name="shoulder_pitch_r" joint="shoulder_pitch_r"/>
    <motor name="elbow_r" joint="elbow_r"/>
    <motor name="neck" joint="neck"/>
  </actuator>
</mujoco>
